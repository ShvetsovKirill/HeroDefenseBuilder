<?xml version="1.0" encoding="utf-8"?>
<!--
  Проверка компиляции без запуска Unity:

      dotnet build CompileCheck.csproj

  Зачем нужен отдельный проект. Unity генерирует Assembly-CSharp.csproj
  с ЯВНЫМ перечнем файлов. Только что созданный .cs туда не попадает,
  пока редактор не перегенерирует проект — и сборка бодро рапортует
  "успешно", не заметив нового файла с ошибкой.

  Здесь импортируется сгенерированный проект целиком (299 ссылок, дефайны,
  анализаторы — всё оттуда, это ведёт Unity и оно всегда свежее),
  а подменяется только список файлов: маска вместо перечня.

  Собранная сборка — мусор, её никто не читает: Unity компилирует
  в Library/ScriptAssemblies. Вывод падает в Temp/ и obj/, оба в .gitignore.
  Переопределять их отсюда бесполезно: MSBuild фиксирует пути в момент
  импорта targets, то есть раньше, чем дочитает этот файл.
-->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="Assembly-CSharp.csproj" />

  <ItemGroup>
    <!-- Долой явный перечень... -->
    <Compile Remove="Assets\**\*.cs" />

    <!-- ...и берём то, что реально лежит на диске.

         Editor-скрипты исключены намеренно: у них своя сборка, в которой
         доступен UnityEditor. Побочная польза — если UnityEditor случайно
         заедет в рантайм-код, сборка тут же упадёт. В самой Unity это
         вылезло бы только при билде игры. -->
    <Compile Include="Assets\**\*.cs" Exclude="Assets\**\Editor\**\*.cs" />
  </ItemGroup>

</Project>
